import java.util.Scanner;

public class atv4 {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        char[] caracteres = new char[10];
        char[] consoantes = new char[10];
        int countConsoantes = 0;

        // Lendo os 10 caracteres
        for(int i = 0; i < caracteres.length; i++) {
            System.out.print("Digite o caractere " + (i+1) + ": ");
            String input = scanner.nextLine();
            
            // Verificando se o usuário digitou algo
            if(input.length() > 0) {
                caracteres[i] = Character.toUpperCase(input.charAt(0));
            } else {
                caracteres[i] = ' ';
            }
        }

        // Verificando quais são consoantes
        for(int i = 0; i < caracteres.length; i++) {
            char c = caracteres[i];
            if(Character.isLetter(c) && !isVogal(c)) {
                consoantes[countConsoantes] = c;
                countConsoantes++;
            }
        }

        System.out.println("RESULTADOS:");
        
        System.out.print("Caracteres digitados: ");
        for(int i = 0; i < caracteres.length; i++) {
            System.out.print(caracteres[i] + " ");
        }
        System.out.println();
        
        System.out.println("Total de consoantes: " + countConsoantes);
        
        System.out.print("Consoantes encontradas: ");
        for(int i = 0; i < countConsoantes; i++) {
            System.out.print(consoantes[i] + " ");
        }
        System.out.println();

        scanner.close();
    }

    // Método auxiliar para verificar se é vogal
    public static boolean isVogal(char c) {
        return c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U';
    }
}
